      <div className="flex-shrink-0 bg-white border-b border-gray-100 px-5 py-3 flex items-center justify-between z-30" style={{ backdropFilter: 'blur(8px)' }}>
        <div className="flex items-center gap-3">
          <div className="w-8 h-8 bg-blue-600 rounded-xl flex items-center justify-center"><Zap className="w-4 h-4 text-white" /></div>
          <span className="font-bold text-gray-900 text-sm">任務系統 Demo</span>
          <span className="text-xs bg-blue-100 text-blue-600 px-2 py-0.5 rounded-full font-medium">BETA</span>
        </div>
        <div className="flex items-center gap-1 bg-gray-100 rounded-xl p-1">
          {ROLE_CONFIGS.map(r => (
            <button key={r.id} onClick={() => setRole(r.id)}
              className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${role === r.id ? 'bg-white shadow-sm text-gray-900' : 'text-gray-500 hover:text-gray-700'}`}>
              <r.icon className="w-3.5 h-3.5" />{r.label}
            </button>
          ))}
        </div>
        <div className="flex items-center gap-2">
          <button onClick={() => notify('你有 3 個待辦通知！')} className="relative p-2 hover:bg-gray-100 rounded-xl transition-colors">
            <Bell className="w-5 h-5 text-gray-500" />
            <span className="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full" />
          </button>
          <div className="w-8 h-8 bg-gradient-to-br from-blue-500 to-indigo-600 rounded-full flex items-center justify-center"><User className="w-4 h-4 text-white" /></div>
        </div>
      </div>

      <div className="flex flex-1 overflow-hidden">
        <div className="w-52 flex-shrink-0 bg-white border-r border-gray-100 p-4 flex flex-col">
          <nav className="space-y-1 flex-1">
            {NAV_ITEMS.map(item => (
              <button key={item.id} onClick={() => setTab(item.id)}
                className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-all ${tab === item.id ? 'bg-blue-50 text-blue-700' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}`}>
                <item.icon className={`w-4 h-4 flex-shrink-0 ${tab === item.id ? 'text-blue-600' : 'text-gray-400'}`} />{item.label}
              </button>
            ))}
          </nav>
          <div className="pt-4 border-t border-gray-100">
            <div className="px-3 py-3 bg-gray-50 rounded-xl">
              <p className="text-xs font-semibold text-gray-700">{ROLE_CONFIGS.find(r => r.id === role)?.label}</p>
              <p className="text-xs text-gray-400 mt-0.5 leading-relaxed">{ROLE_CONFIGS.find(r => r.id === role)?.hint}</p>
            </div>
          </div>
        </div>

        <div className="flex-1 overflow-y-auto p-6">
          <AnimatePresence mode="wait">
            <motion.div key={tab} initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} exit={{ opacity: 0, y: -8 }} transition={{ duration: 0.18 }}>
              {tab === 'dashboard' && <Dashboard />}
              {tab === 'tasks' && <Tasks />}
              {tab === 'rewards_tab' && <Rewards />}
              {tab === 'nodes' && <Nodes />}
              {tab === 'gantt' && <Gantt />}
              {tab === 'reports' && <Reports />}
            </motion.div>
          </AnimatePresence>
        </div>
      </div>

      <AnimatePresence>
        {showPointsModal && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }}
            className="fixed inset-0 bg-black bg-opacity-25 z-50 flex items-center justify-center p-4"
            style={{ backdropFilter: 'blur(4px)' }}
            onClick={() => setShowPointsModal(false)}>
            <motion.div initial={{ opacity: 0, scale: 0.95, y: 20 }} animate={{ opacity: 1, scale: 1, y: 0 }} exit={{ opacity: 0, scale: 0.95 }}
              onClick={e => e.stopPropagation()}
              className="bg-white rounded-2xl shadow-2xl p-6 w-full max-w-md max-h-screen overflow-y-auto">
              <div className="flex items-center justify-between mb-5">
                <h3 className="font-bold text-gray-900 text-lg">調整積分</h3>
                <button onClick={() => setShowPointsModal(false)} className="p-1.5 hover:bg-gray-100 rounded-lg transition-colors"><X className="w-5 h-5 text-gray-500" /></button>
              </div>
              <div className="flex gap-2 mb-5">
                {[{ id: 'add', label: '➕ 加分' }, { id: 'subtract', label: '➖ 扣分' }].map(btn => (
                  <button key={btn.id} onClick={() => setPtType(btn.id)}
                    className={`flex-1 py-2.5 rounded-xl text-sm font-medium border transition-colors ${ptType === btn.id ? (btn.id === 'add' ? 'bg-green-50 text-green-700 border-green-200' : 'bg-red-50 text-red-700 border-red-200') : 'bg-gray-50 text-gray-500 border-gray-200'}`}>
                    {btn.label}
                  </button>
                ))}
              </div>
              <div className="mb-5">
                <label className="text-sm font-medium text-gray-700 mb-2 block">選擇學生</label>
                <div className="grid grid-cols-3 gap-2">
                  {students.map(s => (
                    <button key={s.id} onClick={() => setSelStudentId(s.id)}
                      className={`p-2.5 rounded-xl border text-center transition-all ${selStudentId === s.id ? 'border-blue-400 bg-blue-50' : 'border-gray-200 hover:bg-gray-50'}`}>
                      <div className="text-xl mb-0.5">{s.emoji}</div>
                      <div className="text-xs font-medium text-gray-800">{s.name}</div>
                      <div className="text-xs text-gray-400">{s.points}分</div>
                    </button>
                  ))}
                </div>
              </div>
              <div className="mb-5">
                <label className="text-sm font-medium text-gray-700 mb-2 block">積分數量</label>
                <div className="flex gap-2">
                  <input type="number" value={ptAmount} onChange={e => setPtAmount(e.target.value)} placeholder="輸入積分"
                    className="flex-1 border border-gray-200 rounded-xl px-3 py-2.5 text-sm outline-none focus:border-blue-400" />
                  {[10, 20, 50].map(n => (
                    <button key={n} onClick={() => setPtAmount(String(n))} className="px-3 py-2.5 bg-gray-100 text-gray-700 rounded-xl text-sm hover:bg-gray-200 font-medium">{n}</button>
                  ))}
                </div>
              </div>
              <div className="mb-5">
                <label className="text-sm font-medium text-gray-700 mb-2 block">原因</label>
                <div className="flex flex-wrap gap-1.5 mb-2">
                  {['默書滿分', '積極參與', '協助同學', '比賽獲獎', '遲交功課', '違反規則'].map(r => (
                    <button key={r} onClick={() => setPtReason(r)}
                      className={`text-xs px-2.5 py-1.5 rounded-lg border transition-colors ${ptReason === r ? 'border-blue-400 bg-blue-50 text-blue-700' : 'border-gray-200 text-gray-600 hover:bg-gray-50'}`}>
                      {r}
                    </button>
                  ))}
                </div>
                <input type="text" value={ptReason} onChange={e => setPtReason(e.target.value)} placeholder="或自行輸入原因..."
                  className="w-full border border-gray-200 rounded-xl px-3 py-2.5 text-sm outline-none focus:border-blue-400" />
              </div>
              <button onClick={handlePoints} disabled={!selStudentId || !ptAmount || !ptReason}
                className={`w-full py-3 rounded-xl font-medium text-sm transition-colors ${selStudentId && ptAmount && ptReason ? (ptType === 'add' ? 'bg-green-500 hover:bg-green-600 text-white' : 'bg-red-500 hover:bg-red-600 text-white') : 'bg-gray-100 text-gray-400 cursor-not-allowed'}`}>
                確認{ptType === 'add' ? '加分' : '扣分'}
              </button>
            </motion.div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  );
}
