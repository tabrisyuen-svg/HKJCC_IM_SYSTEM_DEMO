function submitLeave() {
  const reason = document.getElementById('leaveReason').value.trim();
  if (!reason) { showToast('請填寫請假原因'); return; }
  currentStudent.leaveHistory.unshift({
    date: document.getElementById('leaveDate').value,
    days: parseInt(document.getElementById('leaveDays').value)||1,
    reason,
    status:'pending'
  });
  showToast('請假申請已提交，等待老師批核 ✓');
  renderLeave();
}

