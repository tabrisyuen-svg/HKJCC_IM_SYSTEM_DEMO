import React, { useState } from 'react';
import {
  RadarChart, Radar, PolarGrid, PolarAngleAxis,
  PolarRadiusAxis, ResponsiveContainer
} from 'recharts';
import { BookOpen, CheckCircle, XCircle, BarChart2, ChevronRight } from 'lucide-react';

const questions = [
  {
    id: 1, topic: '分數計算', subject: '數學',
    question: '½ + ⅓ 等於多少？',
    options: ['2/5', '2/6', '5/6', '3/5'],
    correct: 2,
    explanation: '分數相加先通分：½ = 3/6，⅓ = 2/6，所以 3/6 + 2/6 = 5/6。',
  },
  {
    id: 2, topic: '閱讀理解', subject: '中文',
    question: '「春眠不覺曉」的下一句是？',
    options: ['夜來風雨聲', '處處聞啼鳥', '花落知多少', '窗前明月光'],
    correct: 1,
    explanation: '《春曉》：春眠不覺曉，處處聞啼鳥。夜來風雨聲，花落知多少。',
  },
  {
    id: 3, topic: '幾何', subject: '數學',
    question: '正方形邊長 5cm，面積是？',
    options: ['10 cm²', '20 cm²', '25 cm²', '15 cm²'],
    correct: 2,
    explanation: '正方形面積 = 邊長 × 邊長 = 5 × 5 = 25 cm²。',
  },
  {
    id: 4, topic: '詞彙', subject: '英文',
    question: 'Which word means "happy"?',
    options: ['Sad', 'Angry', 'Joyful', 'Tired'],
    correct: 2,
    explanation: '"Joyful" means feeling great happiness — a direct synonym of "happy".',
  },
  {
    id: 5, topic: '句子結構', subject: '英文',
    question: 'Choose the correct sentence:',
    options: ['She go to school.', 'She goes to school.', 'She going to school.', 'She gone to school.'],
    correct: 1,
    explanation: 'Third-person singular (she/he/it) needs -s or -es added to the verb. "Go" → "Goes".',
  },
];

const LEVELS = [
  { label: '需加強', color: '#EF4444', textClass: 'text-red-600', bgClass: 'bg-red-50', borderClass: 'border-red-200', dotClass: 'bg-red-400' },
  { label: '鞏固中', color: '#F59E0B', textClass: 'text-yellow-600', bgClass: 'bg-yellow-50', borderClass: 'border-yellow-200', dotClass: 'bg-yellow-400' },
  { label: '已掌握', color: '#10B981', textClass: 'text-emerald-600', bgClass: 'bg-emerald-50', borderClass: 'border-emerald-200', dotClass: 'bg-emerald-400' },
];

const initMastery = {
  '分數計算': { streak: 0, level: 0 },
  '閱讀理解': { streak: 2, level: 1 },
  '幾何':     { streak: 3, level: 2 },
  '詞彙':     { streak: 1, level: 0 },
  '句子結構': { streak: 2, level: 1 },
};

const initWrong = [
  { ...questions[0], picked: 0, time: '10 分鐘前' },
];

export default function App() {
  const [tab, setTab] = useState('practice');
  const [qIdx, setQIdx] = useState(0);
  const [picked, setPicked] = useState(null);
  const [submitted, setSubmitted] = useState(false);
  const [mastery, setMastery] = useState(initMastery);
  const [wrong, setWrong] = useState(initWrong);
  const [stats, setStats] = useState({ total: 0, correct: 0 });

  const q = questions[qIdx];
  const isRight = picked === q.correct;
  const curMastery = mastery[q.topic] || { streak: 0, level: 0 };

  const handleSubmit = () => {
    if (picked === null) return;
    const prev = mastery[q.topic] || { streak: 0, level: 0 };
    let newStreak = prev.streak;
    let newLevel = prev.level;

    if (picked === q.correct) {
      newStreak = prev.streak + 1;
      if (newStreak >= 3 && newLevel < 2) { newLevel = newLevel + 1; newStreak = 0; }
      setStats(s => ({ total: s.total + 1, correct: s.correct + 1 }));
    } else {
      newStreak = 0;
      newLevel = Math.max(prev.level - 1, 0);
      setWrong(w => [{ ...q, picked, time: '剛剛' }, ...w.filter(x => x.id !== q.id)]);
      setStats(s => ({ total: s.total + 1, correct: s.correct }));
    }
    setMastery(m => ({ ...m, [q.topic]: { streak: newStreak, level: newLevel } }));
    setSubmitted(true);
  };

  const handleNext = () => { setPicked(null); setSubmitted(false); setQIdx(i => (i + 1) % questions.length); };

  const radarData = Object.entries(mastery).map(([topic, val]) => ({
    topic,
    value: val.level === 0 ? 18 : val.level === 1 ? 55 : 90,
  }));

  const tabs = [
    { key: 'practice', label: '練習', icon: <ChevronRight size={13} /> },
    { key: 'wrong',    label: '錯題本', icon: <BookOpen size={13} /> },
    { key: 'progress', label: '進度',  icon: <BarChart2 size={13} /> },
  ];

  return (
    <div className="min-h-screen bg-slate-50">
      <div className="max-w-lg mx-auto px-4 py-6">

        {/* Header */}
        <div className="mb-5">
          <p className="text-xs text-slate-400 font-mono mb-1">S-01 · Module 01</p>
          <h1 className="text-2xl font-bold text-slate-900">錯題本 · 學習路徑</h1>
          <p className="text-sm text-slate-500 mt-0.5">Spaced Repetition · 三級掌握追蹤</p>
        </div>

        {/* Stats */}
        <div className="grid grid-cols-3 gap-2 mb-5">
          {[
            { val: stats.total,   label: '已作答', color: 'text-slate-800' },
            { val: stats.correct, label: '答對',   color: 'text-emerald-600' },
            { val: wrong.length,  label: '錯題',   color: 'text-red-500' },
          ].map((s, i) => (
            <div key={i} className="bg-white rounded-2xl p-3 text-center border border-slate-100 shadow-sm">
              <div className={`text-xl font-bold ${s.color}`}>{s.val}</div>
              <div className="text-xs text-slate-400 mt-0.5">{s.label}</div>
            </div>
          ))}
        </div>

        {/* Tabs */}
        <div className="flex gap-1 bg-slate-100 rounded-2xl p-1 mb-5">
          {tabs.map(t => (
            <button key={t.key} onClick={() => setTab(t.key)}
              className={`flex-1 flex items-center justify-center gap-1.5 py-2 rounded-xl text-sm font-medium transition-all
                ${tab === t.key ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-700'}`}>
              {t.icon}{t.label}
            </button>
          ))}
        </div>

        {/* ── PRACTICE TAB ── */}
        {tab === 'practice' && (
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <div className="flex items-center gap-2">
                <span className="text-xs bg-indigo-50 text-indigo-600 px-2 py-1 rounded-full border border-indigo-100 font-medium">{q.subject}</span>
                <span className="text-xs text-slate-500">{q.topic}</span>
              </div>
              <span className="text-xs text-slate-400">{qIdx + 1} / {questions.length}</span>
            </div>

            <div className="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm">
              <p className="text-slate-900 font-semibold text-base leading-relaxed mb-4">{q.question}</p>
              <div className="space-y-2">
                {q.options.map((opt, i) => {
                  let cls = 'border-slate-200 bg-white text-slate-700 hover:border-indigo-300 hover:bg-indigo-50 cursor-pointer';
                  if (submitted) {
                    if (i === q.correct) cls = 'border-emerald-400 bg-emerald-50 text-emerald-800 cursor-default';
                    else if (i === picked) cls = 'border-red-400 bg-red-50 text-red-700 cursor-default';
                    else cls = 'border-slate-100 bg-slate-50 text-slate-400 cursor-default';
                  } else if (picked === i) {
                    cls = 'border-indigo-400 bg-indigo-50 text-indigo-800 cursor-pointer';
                  }
                  return (
                    <button key={i} disabled={submitted} onClick={() => setPicked(i)}
                      className={`w-full text-left px-4 py-3 rounded-xl border-2 text-sm font-medium transition-all flex items-center gap-3 ${cls}`}>
                      <span className="w-6 h-6 rounded-full border-2 border-current flex items-center justify-center text-xs font-bold flex-shrink-0">
                        {String.fromCharCode(65 + i)}
                      </span>
                      <span className="flex-1">{opt}</span>
                      {submitted && i === q.correct && <CheckCircle size={15} className="text-emerald-500 flex-shrink-0" />}
                      {submitted && i === picked && i !== q.correct && <XCircle size={15} className="text-red-500 flex-shrink-0" />}
                    </button>
                  );
                })}
              </div>
              <div className="mt-4">
                {!submitted ? (
                  <button onClick={handleSubmit} disabled={picked === null}
                    className="w-full py-3 bg-slate-900 text-white rounded-xl text-sm font-semibold disabled:opacity-30 transition-opacity">
                    確認答案
                  </button>
                ) : (
                  <button onClick={handleNext}
                    className="w-full py-3 bg-slate-900 text-white rounded-xl text-sm font-semibold">
                    下一題 →
                  </button>
                )}
              </div>
            </div>

            {/* Explanation unlock */}
            {submitted && (
              <div className={`rounded-2xl p-4 border ${isRight ? 'bg-emerald-50 border-emerald-200' : 'bg-amber-50 border-amber-200'}`}>
                <div className="flex items-center gap-2 mb-2">
                  {isRight
                    ? <CheckCircle size={15} className="text-emerald-600" />
                    : <BookOpen size={15} className="text-amber-600" />
                  }
                  <span className={`text-xs font-semibold ${isRight ? 'text-emerald-700' : 'text-amber-700'}`}>
                    {isRight ? '答對了！繼續保持' : '解說已解鎖'}
                  </span>
                </div>
                <p className="text-sm text-slate-700 leading-relaxed">{q.explanation}</p>
                <div className={`mt-3 pt-3 border-t ${isRight ? 'border-emerald-200' : 'border-amber-200'} flex items-center gap-2 flex-wrap`}>
                  <span className="text-xs text-slate-500">「{q.topic}」掌握程度：</span>
                  <span className={`text-xs font-bold px-2 py-0.5 rounded-full border
                    ${LEVELS[mastery[q.topic]?.level || 0].bgClass}
                    ${LEVELS[mastery[q.topic]?.level || 0].textClass}
                    ${LEVELS[mastery[q.topic]?.level || 0].borderClass}`}>
                    {LEVELS[mastery[q.topic]?.level || 0].label}
                  </span>
                  {isRight && (mastery[q.topic]?.streak || 0) > 0 && (mastery[q.topic]?.level || 0) < 2 && (
                    <span className="text-xs text-slate-400">
                      連續答對 {mastery[q.topic]?.streak} 次，再 {3 - (mastery[q.topic]?.streak || 0)} 次升級
                    </span>
                  )}
                </div>
              </div>
            )}
          </div>
        )}

        {/* ── WRONG ANSWER TAB ── */}
        {tab === 'wrong' && (
          <div className="space-y-3">
            {wrong.length === 0 ? (
              <div className="bg-white rounded-2xl p-10 text-center border border-slate-100">
                <CheckCircle size={32} className="text-emerald-400 mx-auto mb-2" />
                <p className="text-slate-500 text-sm">暫時沒有錯題 🎉</p>
              </div>
            ) : wrong.map((w, i) => (
              <div key={i} className="bg-white rounded-2xl p-4 border border-slate-100 shadow-sm">
                <div className="flex items-center justify-between mb-2">
                  <div className="flex items-center gap-2">
                    <span className="text-xs bg-red-50 text-red-600 px-2 py-0.5 rounded-full border border-red-100 font-medium">{w.subject}</span>
                    <span className="text-xs text-slate-400">{w.topic}</span>
                  </div>
                  <span className="text-xs text-slate-300">{w.time}</span>
                </div>
                <p className="text-sm font-semibold text-slate-800 mb-3">{w.question}</p>
                <div className="space-y-1.5">
                  {w.options.map((opt, j) => (
                    <div key={j} className={`px-3 py-2 rounded-xl text-xs flex items-center gap-2 border ${
                      j === w.correct ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                      j === w.picked  ? 'bg-red-50 text-red-600 border-red-200' :
                      'bg-slate-50 text-slate-400 border-slate-100'
                    }`}>
                      <span className="font-bold">{String.fromCharCode(65 + j)}.</span>
                      <span className="flex-1">{opt}</span>
                      {j === w.correct && <CheckCircle size={11} />}
                      {j === w.picked && j !== w.correct && <XCircle size={11} />}
                    </div>
                  ))}
                </div>
                <div className="mt-3 pt-3 border-t border-slate-100">
                  <p className="text-xs text-slate-500 leading-relaxed">{w.explanation}</p>
                </div>
              </div>
            ))}
          </div>
        )}

        {/* ── PROGRESS TAB ── */}
        {tab === 'progress' && (
          <div className="space-y-3">
            <div className="bg-white rounded-2xl p-4 border border-slate-100 shadow-sm">
              <p className="text-sm font-semibold text-slate-700 mb-1">知識點掌握雷達圖</p>
              <ResponsiveContainer width="100%" height={220}>
                <RadarChart cx="50%" cy="50%" outerRadius="70%" data={radarData}>
                  <PolarGrid stroke="#E2E8F0" />
                  <PolarAngleAxis dataKey="topic" tick={{ fontSize: 11, fill: '#64748B' }} />
                  <PolarRadiusAxis domain={[0, 100]} tick={false} axisLine={false} />
                  <Radar dataKey="value" stroke="#6366F1" fill="#6366F1" fillOpacity={0.2} strokeWidth={2}
                    dot={{ r: 3, fill: '#6366F1' }} />
                </RadarChart>
              </ResponsiveContainer>
            </div>

            <div className="bg-white rounded-2xl p-4 border border-slate-100 shadow-sm">
              <p className="text-sm font-semibold text-slate-700 mb-3">各知識點狀態</p>
              <div className="space-y-3">
                {Object.entries(mastery).map(([topic, val]) => {
                  const lv = LEVELS[val.level];
                  const pct = val.level === 0 ? 18 : val.level === 1 ? 55 : 90;
                  return (
                    <div key={topic}>
                      <div className="flex items-center justify-between mb-1">
                        <div className="flex items-center gap-2">
                          <span className={`w-2 h-2 rounded-full ${lv.dotClass}`} />
                          <span className="text-sm text-slate-700">{topic}</span>
                        </div>
                        <span className={`text-xs font-medium ${lv.textClass}`}>{lv.label}</span>
                      </div>
                      <div className="h-1.5 bg-slate-100 rounded-full overflow-hidden">
                        <div className="h-full rounded-full transition-all duration-500"
                          style={{ width: `${pct}%`, backgroundColor: lv.color }} />
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            <div className="bg-white rounded-2xl p-4 border border-slate-100 shadow-sm">
              <p className="text-sm font-semibold text-slate-700 mb-3">🔁 Spaced Repetition 複習順序</p>
              <div className="space-y-2">
                {Object.entries(mastery)
                  .sort((a, b) => a[1].level - b[1].level || a[1].streak - b[1].streak)
                  .map(([topic, val], i) => {
                    const lv = LEVELS[val.level];
                    return (
                      <div key={topic} className="flex items-center gap-3 py-1">
                        <span className="text-xs text-slate-300 w-5 text-center font-mono">{i + 1}</span>
                        <span className="text-sm text-slate-700 flex-1">{topic}</span>
                        {val.level === 0 && <span className="text-xs text-red-400">⚡ 優先</span>}
                        <span className={`text-xs px-2 py-0.5 rounded-full border ${lv.bgClass} ${lv.textClass} ${lv.borderClass}`}>
                          {lv.label}
                        </span>
                      </div>
                    );
                  })}
              </div>
            </div>
          </div>
        )}

      </div>
    </div>
  );
}
