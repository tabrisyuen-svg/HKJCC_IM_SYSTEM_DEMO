<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>T-09 · Staff Analytics</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang HK',sans-serif;background:#f7f7f5;color:#1a1a1a;min-height:100vh;}

/* Header */
.header{background:#1a1a1a;color:#fff;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
.header-left{display:flex;align-items:center;gap:14px;}
.logo{font-size:12px;font-weight:700;letter-spacing:.08em;color:#d4ff6e;}
.header-title{font-size:15px;font-weight:600;}
.admin-badge{background:#d4ff6e;color:#1a1a1a;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;}

/* Period toggle */
.period-row{background:#fff;border-bottom:1px solid #ebebeb;padding:12px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
.period-group{display:flex;gap:4px;background:#f0f0f0;border-radius:8px;padding:4px;}
.period-btn{padding:5px 14px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:none;background:transparent;color:#888;transition:.15s;}
.period-btn.active{background:#1a1a1a;color:#fff;}
.export-row{display:flex;gap:8px;}
.btn{padding:7px 14px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;border:none;transition:.2s;white-space:nowrap;}
.btn:hover{opacity:.8;}
.btn-red{background:#ef4444;color:#fff;}
.btn-green{background:#22c55e;color:#fff;}

/* Layout */
.layout{display:grid;grid-template-columns:280px 1fr;min-height:calc(100vh - 105px);}
@media(max-width:720px){.layout{grid-template-columns:1fr;}}

/* Sidebar */
.sidebar{background:#fff;border-right:1px solid #ebebeb;overflow-y:auto;}
.sidebar-label{font-size:10px;font-weight:700;letter-spacing:.1em;color:#bbb;padding:14px 16px 8px;text-transform:uppercase;}
.staff-item{display:flex;align-items:center;gap:12px;padding:12px 16px;cursor:pointer;border-bottom:1px solid #f7f7f7;transition:.15s;border-left:3px solid transparent;}
.staff-item:hover{background:#f9f9f9;}
.staff-item.active{background:#f0f6ff;border-left-color:#3b82f6;}
.s-avatar{width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0;}
.s-info{flex:1;min-width:0;}
.s-name{font-size:13px;font-weight:600;}
.s-role{font-size:11px;color:#aaa;}
.s-score{font-size:13px;font-weight:700;flex-shrink:0;}
.alert-dot{width:7px;height:7px;border-radius:50%;background:#ef4444;flex-shrink:0;}

/* Main */
.main{padding:24px;overflow-y:auto;}

/* Overview grid */
.overview-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-bottom:24px;}
.ov-card{background:#fff;border-radius:14px;border:1px solid #e8e8e8;padding:18px;}
.ov-val{font-size:28px;font-weight:700;margin-bottom:4px;}
.ov-lbl{font-size:11px;color:#aaa;font-weight:600;letter-spacing:.04em;text-transform:uppercase;}
.ov-sub{font-size:11px;margin-top:6px;font-weight:500;}

/* Section */
.section-title{font-size:12px;font-weight:700;letter-spacing:.06em;color:#aaa;text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.section-title span{font-size:15px;}
.card{background:#fff;border-radius:14px;border:1px solid #e8e8e8;padding:20px;margin-bottom:16px;}

/* Bar chart */
.bar-chart{display:flex;flex-direction:column;gap:10px;}
.bar-row{display:flex;align-items:center;gap:12px;}
.bar-label{font-size:12px;font-weight:600;min-width:90px;color:#555;}
.bar-wrap{flex:1;height:20px;background:#f0f0f0;border-radius:20px;overflow:hidden;}
.bar-fill{height:100%;border-radius:20px;transition:width .6s cubic-bezier(.4,0,.2,1);}
.bar-val{font-size:12px;font-weight:700;min-width:36px;text-align:right;}

/* Module table */
.mod-table{width:100%;border-collapse:collapse;}
.mod-table th{font-size:10px;font-weight:700;color:#bbb;text-transform:uppercase;letter-spacing:.06em;padding:8px 10px;text-align:left;border-bottom:2px solid #f0f0f0;white-space:nowrap;}
.mod-table td{padding:11px 10px;font-size:13px;border-bottom:1px solid #f7f7f7;vertical-align:middle;}
.mod-table tr:last-child td{border-bottom:none;}
.mod-table tr:hover td{background:#fafafa;}
.pill{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.pill-green{background:#f0fdf4;color:#22c55e;}
.pill-orange{background:#fff7ed;color:#f97316;}
.pill-red{background:#fef2f2;color:#ef4444;}
.pill-gray{background:#f5f5f5;color:#aaa;}
.pill-blue{background:#eff6ff;color:#3b82f6;}

/* Activity log */
.log-item{display:flex;align-items:flex-start;gap:12px;padding:10px 0;border-bottom:1px solid #f7f7f7;}
.log-item:last-child{border-bottom:none;}
.log-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.log-time{font-size:11px;color:#bbb;min-width:80px;flex-shrink:0;margin-top:1px;}
.log-text{font-size:13px;color:#444;line-height:1.5;}
.log-mod{font-size:10px;font-weight:700;padding:2px 7px;border-radius:6px;margin-left:6px;letter-spacing:.04em;}

/* Alert banner */
.alert-banner{background:#fef2f2;border:1px solid #fecaca;border-radius:12px;padding:14px 16px;display:flex;gap:10px;align-items:flex-start;margin-bottom:16px;}
.alert-banner-icon{font-size:16px;flex-shrink:0;}
.alert-banner-text{font-size:13px;color:#b91c1c;line-height:1.55;}
.alert-banner-text strong{display:block;font-size:11px;font-weight:700;letter-spacing:.04em;margin-bottom:3px;}

/* Radar-style module dots */
.mod-dots{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px;}
.mod-dot-item{display:flex;flex-direction:column;align-items:center;gap:4px;}
.mod-dot-ring{width:44px;height:44px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;border:3px solid;}
.mod-dot-lbl{font-size:10px;color:#aaa;font-weight:600;}

/* Detail name row */
.detail-top{display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap;}
.detail-avatar{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:700;flex-shrink:0;}
.detail-name{font-size:20px;font-weight:700;}
.detail-meta{font-size:12px;color:#aaa;margin-top:3px;}

/* Score ring */
.score-ring{display:flex;align-items:center;gap:8px;margin-left:auto;}
.score-big{font-size:32px;font-weight:700;}
.score-sub{font-size:11px;color:#aaa;font-weight:600;letter-spacing:.04em;text-transform:uppercase;}

/* Trend mini */
.trend-row{display:flex;gap:4px;align-items:flex-end;height:32px;margin-top:8px;}
.trend-bar{width:14px;border-radius:3px 3px 0 0;background:#3b82f6;opacity:.7;}

@media(max-width:520px){.overview-grid{grid-template-columns:1fr 1fr;}.main{padding:14px;}.period-row{padding:10px 14px;}}
</style>
</head>
