<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>T-08 · Events</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI','PingFang HK',sans-serif;background:#f7f7f5;color:#1a1a1a;min-height:100vh;}

/* Header */
.header{background:#1a1a1a;color:#fff;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
.header-left{display:flex;align-items:center;gap:14px;}
.logo{font-size:12px;font-weight:700;letter-spacing:.08em;color:#d4ff6e;}
.header-title{font-size:15px;font-weight:600;}
.btn{padding:8px 16px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;border:none;transition:.2s;white-space:nowrap;}
.btn:hover{opacity:.8;}
.btn-add{background:#d4ff6e;color:#1a1a1a;}
.btn-dark{background:#2a2a2a;color:#fff;}
.btn-red{background:#ef4444;color:#fff;}
.btn-green{background:#22c55e;color:#fff;}
.btn-blue{background:#3b82f6;color:#fff;}
.btn-gray{background:#f0f0f0;color:#555;}

/* View toggle */
.view-toggle{display:flex;gap:4px;background:#2a2a2a;border-radius:8px;padding:4px;}
.vt-btn{padding:5px 12px;border-radius:6px;font-size:12px;font-weight:600;cursor:pointer;border:none;background:transparent;color:#888;transition:.15s;}
.vt-btn.active{background:#fff;color:#1a1a1a;}

/* Layout */
.layout{display:grid;grid-template-columns:300px 1fr;min-height:calc(100vh - 57px);}
@media(max-width:720px){.layout{grid-template-columns:1fr;}}

/* Sidebar */
.sidebar{background:#fff;border-right:1px solid #ebebeb;display:flex;flex-direction:column;}
.sidebar-header{padding:14px 16px;border-bottom:1px solid #ebebeb;display:flex;flex-direction:column;gap:10px;}
.filter-row{display:flex;gap:6px;flex-wrap:wrap;}
.filter-chip{padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;cursor:pointer;border:1px solid #e0e0e0;background:#fff;color:#888;transition:.15s;}
.filter-chip.active{border-color:transparent;color:#fff;}
.filter-chip.fc-all{background:#1a1a1a;color:#fff;border-color:#1a1a1a;}
.filter-chip.fc-school.active{background:#3b82f6;}
.filter-chip.fc-trip.active{background:#10b981;}
.filter-chip.fc-comp.active{background:#f59e0b;}
.filter-chip.fc-ceremony.active{background:#8b5cf6;}
.filter-chip.fc-other.active{background:#94a3b8;}

.event-list{overflow-y:auto;flex:1;}
.event-item{padding:14px 16px;cursor:pointer;border-bottom:1px solid #f5f5f5;transition:.15s;border-left:3px solid transparent;display:flex;align-items:flex-start;gap:10px;}
.event-item:hover{background:#f9f9f9;}
.event-item.active{background:#f0f6ff;border-left-color:#3b82f6;}
.ei-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:4px;}
.ei-body{flex:1;min-width:0;}
.ei-name{font-size:13px;font-weight:600;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ei-meta{font-size:11px;color:#aaa;display:flex;gap:8px;flex-wrap:wrap;}
.ei-badge{display:inline-block;padding:2px 7px;border-radius:10px;font-size:10px;font-weight:700;}

/* Main */
.main{padding:24px;overflow-y:auto;}

/* Calendar */
.cal-wrap{background:#fff;border-radius:16px;border:1px solid #e8e8e8;overflow:hidden;margin-bottom:20px;}
.cal-header{background:#1a1a1a;color:#fff;padding:14px 20px;display:flex;align-items:center;justify-content:space-between;}
.cal-title{font-size:15px;font-weight:700;}
.cal-nav{display:flex;gap:6px;}
.cal-nav-btn{background:#2a2a2a;color:#fff;border:none;border-radius:6px;width:30px;height:30px;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;}
.cal-nav-btn:hover{background:#3a3a3a;}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);}
.cal-dow{padding:8px 4px;text-align:center;font-size:11px;font-weight:700;color:#bbb;letter-spacing:.04em;background:#fafafa;border-bottom:1px solid #f0f0f0;}
.cal-day{min-height:72px;padding:6px;border-right:1px solid #f0f0f0;border-bottom:1px solid #f0f0f0;cursor:pointer;transition:.15s;position:relative;}
.cal-day:hover{background:#f9f9f9;}
.cal-day.other-month{background:#fcfcfc;}
.cal-day.other-month .cal-day-num{color:#ddd;}
.cal-day.today .cal-day-num{background:#1a1a1a;color:#fff;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;}
.cal-day-num{font-size:12px;font-weight:600;margin-bottom:4px;width:22px;height:22px;display:flex;align-items:center;justify-content:center;}
.cal-event-dot{font-size:10px;font-weight:600;padding:1px 5px;border-radius:4px;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;}

/* Detail */
.card{background:#fff;border-radius:14px;border:1px solid #e8e8e8;padding:20px;margin-bottom:16px;}
.card-title{font-size:12px;font-weight:700;letter-spacing:.06em;color:#aaa;text-transform:uppercase;margin-bottom:14px;display:flex;align-items:center;gap:8px;}
.card-title span{font-size:15px;}
.detail-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:20px;}
.detail-name{font-size:22px;font-weight:700;margin-bottom:6px;}
.detail-meta{display:flex;gap:12px;flex-wrap:wrap;font-size:13px;color:#888;}
.detail-meta strong{color:#1a1a1a;}
.info-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;}
.info-item label{font-size:10px;color:#bbb;font-weight:700;letter-spacing:.06em;text-transform:uppercase;display:block;margin-bottom:4px;}
.info-item p{font-size:13px;font-weight:500;}

/* Stats row */
.stats-row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px;}
.stat-box{flex:1;min-width:100px;background:#f9f9f9;border-radius:12px;padding:14px 16px;border:1px solid #f0f0f0;}
.stat-box .s-val{font-size:24px;font-weight:700;margin-bottom:2px;}
.stat-box .s-lbl{font-size:11px;color:#bbb;font-weight:600;letter-spacing:.04em;text-transform:uppercase;}

/* Student table */
.stu-table{width:100%;border-collapse:collapse;}
.stu-table th{font-size:11px;font-weight:700;color:#aaa;text-transform:uppercase;letter-spacing:.04em;padding:8px 10px;text-align:left;border-bottom:2px solid #f0f0f0;}
.stu-table td{padding:10px 10px;font-size:13px;border-bottom:1px solid #f7f7f7;vertical-align:middle;}
.stu-table tr:last-child td{border-bottom:none;}
.stu-table tr:hover td{background:#fafafa;}
.status-badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;border:none;transition:.2s;}
.sb-submitted{background:#f0fdf4;color:#22c55e;}
.sb-pending{background:#fff7ed;color:#f97316;}
.sb-absent{background:#f5f5f5;color:#aaa;}
.fee-badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;cursor:pointer;border:none;transition:.2s;}
.fb-paid{background:#eff6ff;color:#3b82f6;}
.fb-unpaid{background:#fef2f2;color:#ef4444;}
.fb-na{background:#f5f5f5;color:#ccc;}

/* Empty state */
.empty{text-align:center;padding:60px 24px;color:#ccc;}
.empty-icon{font-size:40px;margin-bottom:12px;}
.empty p{font-size:14px;}

/* Type colors */
.type-school{background:#eff6ff;color:#3b82f6;}
.type-trip{background:#f0fdf4;color:#10b981;}
.type-comp{background:#fffbeb;color:#f59e0b;}
.type-ceremony{background:#faf5ff;color:#8b5cf6;}
.type-other{background:#f5f5f5;color:#94a3b8;}
.dot-school{background:#3b82f6;}
.dot-trip{background:#10b981;}
.dot-comp{background:#f59e0b;}
.dot-ceremony{background:#8b5cf6;}
.dot-other{background:#94a3b8;}

/* Modal */
.overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:100;align-items:center;justify-content:center;padding:20px;}
.overlay.active{display:flex;}
.modal{background:#fff;border-radius:20px;padding:28px;width:100%;max-width:440px;box-shadow:0 20px 60px rgba(0,0,0,.18);max-height:92vh;overflow-y:auto;}
.modal-title{font-size:16px;font-weight:700;margin-bottom:4px;}
.modal-sub{font-size:12px;color:#999;margin-bottom:22px;}
.form-group{margin-bottom:13px;}
.form-label{font-size:11px;font-weight:700;color:#666;margin-bottom:5px;display:block;letter-spacing:.04em;text-transform:uppercase;}
.form-input,.form-select,.form-textarea{width:100%;padding:9px 13px;border:1px solid #e0e0e0;border-radius:10px;font-size:13px;outline:none;transition:border-color .2s;font-family:inherit;}
.form-input:focus,.form-select:focus,.form-textarea:focus{border-color:#1a1a1a;}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
.modal-actions{display:flex;gap:8px;margin-top:20px;}
.btn-cancel-m{flex:1;background:#f0f0f0;color:#777;}
.btn-save-m{flex:2;background:#1a1a1a;color:#fff;}

/* Toast */
.toast{position:fixed;bottom:24px;right:24px;background:#1a1a1a;color:#fff;padding:11px 18px;border-radius:10px;font-size:13px;transform:translateY(60px);opacity:0;transition:all .3s;z-index:200;pointer-events:none;}
.toast.show{transform:translateY(0);opacity:1;}

@media(max-width:520px){.header{padding:12px 16px;}.main{padding:14px;}.form-row{grid-template-columns:1fr;}}
</style>
</head>
<body>

<div class="header">
    <div class="header-left">
        <span class="logo">T-08</span>
        <span class="header-title">活動管理 · Events</span>
    </div>
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
        <div class="view-toggle">
            <button class="vt-btn active" id="vt-list" onclick="setView('list')">📋 列表</button>
            <button class="vt-btn" id="vt-cal" onclick="setView('cal')">📅 日曆</button>
        </div>
        <button class="btn btn-add" onclick="openAddModal()">＋ 新增活動</button>
    </div>
</div>

<div class="layout">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <div class="filter-row" id="filterRow"></div>
        </div>
        <div class="event-list" id="eventList"></div>
    </div>

    <!-- Main -->
    <div class="main" id="mainArea"></div>
</div>

<!-- Add Event Modal -->
<div class="overlay" id="addOverlay">
    <div class="modal">
        <div class="modal-title">新增活動</div>
        <div class="modal-sub">填寫活動詳情</div>
        <div class="form-group">
            <label class="form-label">活動名稱</label>
            <input class="form-input" id="fName" placeholder="例：全港學界運動會">
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">類型</label>
                <select class="form-select" id="fType">
                    <option value="school">學校活動</option>
                    <option value="trip">校外考察</option>
                    <option value="comp">比賽</option>
                    <option value="ceremony">典禮</option>
                    <option value="other">其他</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">班別</label>
                <select class="form-select" id="fClass">
                    <option value="全校">全校</option>
                    <option value="1A">1A</option>
                    <option value="1B">1B</option>
                    <option value="2A">2A</option>
                    <option value="2B">2B</option>
                    <option value="跨班">跨班</option>
                </select>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">日期</label>
                <input class="form-input" id="fDate" type="date">
            </div>
            <div class="form-group">
                <label class="form-label">時間</label>
                <input class="form-input" id="fTime" type="time">
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">地點</label>
            <input class="form-input" id="fLocation" placeholder="例：學校禮堂、九龍公園...">
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">負責老師</label>
                <input class="form-input" id="fTeacher" placeholder="例：Chan Sir">
            </div>
            <div class="form-group">
                <label class="form-label">費用 (HK$)</label>
                <input class="form-input" id="fFee" type="number" min="0" placeholder="0 = 免費">
            </div>
        </div>
        <div class="form-group">
            <label class="form-label">備註</label>
            <textarea class="form-input" id="fNote" rows="2" placeholder="其他注意事項..."></textarea>
        </div>
        <div class="modal-actions">
            <button class="btn btn-cancel-m" onclick="closeModal('addOverlay')">取消</button>
            <button class="btn btn-save-m" onclick="saveEvent()">建立活動</button>
        </div>
    </div>
</div>

<div class="toast" id="toast"></div>

<script>
// ── Data ──────────────────────────────────────────────
const TYPE_LABEL = {school:'學校活動',trip:'校外考察',comp:'比賽',ceremony:'典禮',other:'其他'};
const TYPE_CLASS = {school:'type-school',trip:'type-trip',comp:'type-comp',ceremony:'type-ceremony',other:'type-other'};
const DOT_CLASS  = {school:'dot-school', trip:'dot-trip', comp:'dot-comp', ceremony:'dot-ceremony',other:'dot-other'};
const CAL_COLOR  = {school:'#3b82f6',trip:'#10b981',comp:'#f59e0b',ceremony:'#8b5cf6',other:'#94a3b8'};

const STUDENTS_ALL = [
    {id:'s1',name:'陳大文',cls:'2A'},{id:'s2',name:'林小燕',cls:'2A'},{id:'s3',name:'黃俊傑',cls:'1B'},
    {id:'s4',name:'張雅詩',cls:'1A'},{id:'s5',name:'李志明',cls:'1A'},{id:'s6',name:'王美儀',cls:'1B'},
    {id:'s7',name:'鄭家豪',cls:'2B'},{id:'s8',name:'吳詩敏',cls:'2B'},{id:'s9',name:'劉建華',cls:'2A'},
    {id:'s10',name:'何嘉欣',cls:'1A'},{id:'s11',name:'曾偉文',cls:'1B'},{id:'s12',name:'梁志強',cls:'2B'},
];

let EVENTS = [
    {
        id:'e1',name:'2026-27 開學典禮',type:'ceremony',cls:'全校',date:'2026-09-01',time:'09:00',
        location:'學校禮堂',teacher:'校長',fee:0,note:'全體學生及家長出席',
        participants: STUDENTS_ALL.map(s=>({...s,slip:Math.random()>.3?'submitted':'pending',paid:'na'}))
    },
    {
        id:'e2',name:'九龍公園自然考察',type:'trip',cls:'2A',date:'2026-10-08',time:'08:30',
        location:'九龍公園',teacher:'Ng Miss',fee:80,note:'帶備午餐及飲用水，穿著運動服',
        participants: STUDENTS_ALL.filter(s=>s.cls==='2A').map(s=>({...s,slip:Math.random()>.2?'submitted':'pending',paid:Math.random()>.25?'paid':'unpaid'}))
    },
    {
        id:'e3',name:'全港學界游泳比賽',type:'comp',cls:'跨班',date:'2026-10-22',time:'13:00',
        location:'香港大球場游泳池',teacher:'Lam Sir',fee:0,note:'代表隊成員參加',
        participants: STUDENTS_ALL.filter((_,i)=>i%3===0).map(s=>({...s,slip:'submitted',paid:'na'}))
    },
    {
        id:'e4',name:'聖誕聯歡晚會',type:'school',cls:'全校',date:'2026-12-18',time:'14:00',
        location:'學校禮堂',teacher:'Chan Sir',fee:50,note:'各班負責準備表演節目',
        participants: STUDENTS_ALL.map(s=>({...s,slip:Math.random()>.4?'submitted':'pending',paid:Math.random()>.4?'paid':'unpaid'}))
    },
    {
        id:'e5',name:'科學博物館參觀',type:'trip',cls:'1B',date:'2026-11-14',time:'09:00',
        location:'香港科學館',teacher:'Ho Sir',fee:60,note:'攜帶工作紙完成觀察記錄',
        participants: STUDENTS_ALL.filter(s=>s.cls==='1B').map(s=>({...s,slip:Math.random()>.3?'submitted':'pending',paid:Math.random()>.3?'paid':'unpaid'}))
    },
    {
        id:'e6',name:'學生會選舉',type:'school',cls:'全校',date:'2026-11-20',time:'10:00',
        location:'各班課室',teacher:'Wong Sir',fee:0,note:'全體學生投票參與',
        participants: STUDENTS_ALL.map(s=>({...s,slip:'submitted',paid:'na'}))
    },
];

let currentView = 'list';
let currentFilter = 'all';
let currentEventId = 'e1';
let calYear = 2026, calMonth = 10; // 0-indexed month

// ── Filters ───────────────────────────────────────────
const FILTERS = [
    {id:'all',label:'全部',cls:'fc-all'},
    {id:'school',label:'學校活動',cls:'fc-school'},
    {id:'trip',label:'校外考察',cls:'fc-trip'},
    {id:'comp',label:'比賽',cls:'fc-comp'},
    {id:'ceremony',label:'典禮',cls:'fc-ceremony'},
];

function renderFilters() {
    document.getElementById('filterRow').innerHTML = FILTERS.map(f=>`
        <button class="filter-chip ${f.cls}${currentFilter===f.id?' active':''}" onclick="setFilter('${f.id}')">${f.label}</button>
    `).join('');
}

function setFilter(id) {
    currentFilter = id;
    renderFilters();
    renderSidebar();
}

// ── Sidebar ───────────────────────────────────────────
function filteredEvents() {
    return EVENTS.filter(e => currentFilter==='all' || e.type===currentFilter)
                 .sort((a,b)=>a.date.localeCompare(b.date));
}

function renderSidebar() {
    const list = document.getElementById('eventList');
    const evs  = filteredEvents();
    if (!evs.length) {
        list.innerHTML = '<div class="empty" style="padding:40px 16px"><div class="empty-icon">📭</div><p>沒有符合條件的活動</p></div>';
        return;
    }
    list.innerHTML = evs.map(e=>{
        const slipPending = e.participants.filter(p=>p.slip==='pending').length;
        const feePending  = e.participants.filter(p=>p.paid==='unpaid').length;
        return `
        <div class="event-item${e.id===currentEventId?' active':''}" onclick="selectEvent('${e.id}')">
            <div class="ei-dot ${DOT_CLASS[e.type]}"></div>
            <div class="ei-body">
                <div class="ei-name">${e.name}</div>
                <div class="ei-meta">
                    <span>${e.date}</span>
                    <span>${e.cls}</span>
                    ${slipPending>0?`<span style="color:#f97316">回條 ${slipPending} 待交</span>`:''}
                    ${feePending>0?`<span style="color:#ef4444">費用 ${feePending} 未繳</span>`:''}
                </div>
                <div style="margin-top:5px"><span class="ei-badge ${TYPE_CLASS[e.type]}">${TYPE_LABEL[e.type]}</span></div>
            </div>
        </div>`;
    }).join('');
}

function selectEvent(id) {
    currentEventId = id;
    renderSidebar();
    renderMain();
}

// ── View toggle ───────────────────────────────────────
function setView(v) {
    currentView = v;
    document.getElementById('vt-list').classList.toggle('active', v==='list');
    document.getElementById('vt-cal').classList.toggle('active',  v==='cal');
    renderMain();
}

// ── Main ──────────────────────────────────────────────
function renderMain() {
    if (currentView==='cal') { renderCalendar(); return; }
    const e = EVENTS.find(x=>x.id===currentEventId);
    if (!e) { document.getElementById('mainArea').innerHTML='<div class="empty"><div class="empty-icon">📋</div><p>選擇左側活動查看詳情</p></div>'; return; }

    const submitted = e.participants.filter(p=>p.slip==='submitted').length;
    const pending   = e.participants.filter(p=>p.slip==='pending').length;
    const paid      = e.participants.filter(p=>p.paid==='paid').length;
    const unpaid    = e.participants.filter(p=>p.paid==='unpaid').length;
    const total     = e.participants.length;

    document.getElementById('mainArea').innerHTML = `
        <div class="detail-top">
            <div>
                <div style="margin-bottom:8px"><span class="ei-badge ${TYPE_CLASS[e.type]}">${TYPE_LABEL[e.type]}</span></div>
                <div class="detail-name">${e.name}</div>
                <div class="detail-meta">
                    <span>📅 <strong>${e.date}</strong></span>
                    <span>🕘 ${e.time}</span>
                    <span>📍 ${e.location}</span>
                    <span>👤 ${e.teacher}</span>
                    <span>🏫 ${e.cls}</span>
                    ${e.fee>0?`<span>💰 HK$${e.fee}</span>`:`<span>免費</span>`}
                </div>
                ${e.note?`<div style="font-size:12px;color:#aaa;margin-top:6px">📝 ${e.note}</div>`:''}
            </div>
            <div style="display:flex;gap:8px;flex-wrap:wrap;">
                <button class="btn btn-red" onclick="window.print()">↓ PDF</button>
                <button class="btn btn-green" onclick="exportCSV('${e.id}')">↓ Excel</button>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-box"><div class="s-val">${total}</div><div class="s-lbl">參與人數</div></div>
            <div class="stat-box"><div class="s-val" style="color:#22c55e">${submitted}</div><div class="s-lbl">回條已交</div></div>
            <div class="stat-box"><div class="s-val" style="color:#f97316">${pending}</div><div class="s-lbl">回條待交</div></div>
            ${e.fee>0?`
            <div class="stat-box"><div class="s-val" style="color:#3b82f6">${paid}</div><div class="s-lbl">已繳費</div></div>
            <div class="stat-box"><div class="s-val" style="color:#ef4444">${unpaid}</div><div class="s-lbl">未繳費</div></div>
            `:''}
            <div class="stat-box"><div class="s-val" style="color:#8b5cf6">豁免</div><div class="s-lbl">出席統計</div></div>
        </div>

        <div class="card">
            <div class="card-title"><span>👥</span> 參與名單</div>
            <div style="overflow-x:auto;">
            <table class="stu-table">
                <thead><tr>
                    <th>姓名</th><th>班別</th><th>回條</th>
                    ${e.fee>0?'<th>繳費</th>':''}
                </tr></thead>
                <tbody id="participantBody"></tbody>
            </table>
            </div>
        </div>`;

    renderParticipants(e);
}

function renderParticipants(e) {
    const tbody = document.getElementById('participantBody');
    if (!tbody) return;
    tbody.innerHTML = e.participants.map((p,i)=>`
        <tr>
            <td style="font-weight:600">${p.name}</td>
            <td style="color:#888">${p.cls}</td>
            <td><button class="status-badge sb-${p.slip}" onclick="toggleSlip('${e.id}',${i})">${p.slip==='submitted'?'✓ 已交':'待交'}</button></td>
            ${e.fee>0?`<td><button class="fee-badge fb-${p.paid}" onclick="toggleFee('${e.id}',${i})">${p.paid==='paid'?'已繳':'未繳'}</button></td>`:''}
        </tr>`).join('');
}

function toggleSlip(eid, idx) {
    const e = EVENTS.find(x=>x.id===eid);
    e.participants[idx].slip = e.participants[idx].slip==='submitted'?'pending':'submitted';
    renderParticipants(e);
    renderSidebar();
    showToast('回條狀態已更新');
}

function toggleFee(eid, idx) {
    const e = EVENTS.find(x=>x.id===eid);
    e.participants[idx].paid = e.participants[idx].paid==='paid'?'unpaid':'paid';
    renderParticipants(e);
    renderSidebar();
    showToast('繳費狀態已更新');
}

// ── Calendar ──────────────────────────────────────────
function renderCalendar() {
    const MONTH_NAMES = ['一月','二月','三月','四月','五月','六月','七月','八月','九月','十月','十一月','十二月'];
    const area = document.getElementById('mainArea');
    const today = new Date();
    const firstDay = new Date(calYear, calMonth, 1).getDay();
    const daysInMonth = new Date(calYear, calMonth+1, 0).getDate();
    const daysInPrev  = new Date(calYear, calMonth, 0).getDate();

    const cells = [];
    for (let i=firstDay-1;i>=0;i--) cells.push({day:daysInPrev-i,cur:false});
    for (let i=1;i<=daysInMonth;i++) cells.push({day:i,cur:true});
    while(cells.length%7!==0) cells.push({day:cells.length-daysInMonth-firstDay+2,cur:false});

    const getEventsForDay = (d) => {
        const ds = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
        return EVENTS.filter(e=>e.date===ds);
    };

    area.innerHTML = `
        <div class="cal-wrap">
            <div class="cal-header">
                <div class="cal-title">${calYear} 年 ${MONTH_NAMES[calMonth]}</div>
                <div class="cal-nav">
                    <button class="cal-nav-btn" onclick="calNav(-1)">‹</button>
                    <button class="cal-nav-btn" onclick="calNav(1)">›</button>
                </div>
            </div>
            <div class="cal-grid">
                ${['日','一','二','三','四','五','六'].map(d=>`<div class="cal-dow">${d}</div>`).join('')}
                ${cells.map(c=>{
                    const isToday = c.cur && c.day===today.getDate() && calMonth===today.getMonth() && calYear===today.getFullYear();
                    const evs = c.cur ? getEventsForDay(c.day) : [];
                    return `<div class="cal-day${c.cur?'':' other-month'}${isToday?' today':''}">
                        <div class="cal-day-num">${c.day}</div>
                        ${evs.slice(0,2).map(e=>`<div class="cal-event-dot" style="background:${CAL_COLOR[e.type]}20;color:${CAL_COLOR[e.type]}" onclick="selectEvent('${e.id}');setView('list')">${e.name}</div>`).join('')}
                        ${evs.length>2?`<div style="font-size:10px;color:#bbb;padding:1px 4px">+${evs.length-2} 更多</div>`:''}
                    </div>`;
                }).join('')}
            </div>
        </div>
        <div class="card">
            <div class="card-title"><span>📋</span> ${MONTH_NAMES[calMonth]} 活動列表</div>
            ${EVENTS.filter(e=>e.date.startsWith(`${calYear}-${String(calMonth+1).padStart(2,'0')}`))
                .sort((a,b)=>a.date.localeCompare(b.date))
                .map(e=>`
                <div style="display:flex;align-items:center;gap:12px;padding:11px 0;border-bottom:1px solid #f5f5f5;cursor:pointer;" onclick="selectEvent('${e.id}');setView('list')">
                    <div style="width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:${CAL_COLOR[e.type]}20;font-size:18px;flex-shrink:0">
                        ${{school:'🏫',trip:'🚌',comp:'🏆',ceremony:'🎓',other:'📌'}[e.type]}
                    </div>
                    <div style="flex:1">
                        <div style="font-size:13px;font-weight:600">${e.name}</div>
                        <div style="font-size:11px;color:#aaa">${e.date} · ${e.time} · ${e.location}</div>
                    </div>
                    <span class="ei-badge ${TYPE_CLASS[e.type]}">${TYPE_LABEL[e.type]}</span>
                </div>`).join('') || '<p style="font-size:13px;color:#bbb">本月暫無活動</p>'}
        </div>`;
}

function calNav(dir) {
    calMonth += dir;
    if (calMonth>11){calMonth=0;calYear++;}
    if (calMonth<0) {calMonth=11;calYear--;}
    renderCalendar();
}

// ── Add Event ─────────────────────────────────────────
function openAddModal() {
    document.getElementById('fName').value='';
    document.getElementById('fLocation').value='';
    document.getElementById('fTeacher').value='';
    document.getElementById('fFee').value='0';
    document.getElementById('fNote').value='';
    document.getElementById('fDate').value=new Date().toISOString().slice(0,10);
    document.getElementById('fTime').value='09:00';
    document.getElementById('addOverlay').classList.add('active');
    setTimeout(()=>document.getElementById('fName').focus(),50);
}

function saveEvent() {
    const name = document.getElementById('fName').value.trim();
    if (!name) { showToast('請輸入活動名稱'); return; }
    const cls  = document.getElementById('fClass').value;
    const type = document.getElementById('fType').value;
    const hasFee = parseInt(document.getElementById('fFee').value)||0;

    const participants = STUDENTS_ALL
        .filter(s => cls==='全校'||cls==='跨班'||s.cls===cls)
        .map(s=>({...s, slip:'pending', paid: hasFee>0?'unpaid':'na'}));

    EVENTS.unshift({
        id:'e'+Date.now(),
        name,
        type,
        cls,
        date:  document.getElementById('fDate').value,
        time:  document.getElementById('fTime').value,
        location: document.getElementById('fLocation').value||'—',
        teacher:  document.getElementById('fTeacher').value||'—',
        fee: hasFee,
        note: document.getElementById('fNote').value,
        participants,
    });
    currentEventId = EVENTS[0].id;
    closeModal('addOverlay');
    renderSidebar();
    renderMain();
    showToast('活動已建立 ✓');
}

// ── Export ────────────────────────────────────────────
function exportCSV(eid) {
    const e = EVENTS.find(x=>x.id===eid);
    let csv = `活動名稱,${e.name}\n日期,${e.date}\n地點,${e.location}\n\n姓名,班別,回條,繳費\n`;
    e.participants.forEach(p=>{
        csv += `${p.name},${p.cls},${p.slip==='submitted'?'已交':'待交'},${p.paid==='paid'?'已繳':p.paid==='unpaid'?'未繳':'不適用'}\n`;
    });
    const blob = new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `Event_${e.name}.csv`;
    a.click();
    showToast('Excel 匯出完成 ✓');
}

// ── Utils ─────────────────────────────────────────────
function closeModal(id) { document.getElementById(id).classList.remove('active'); }
function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(()=>t.classList.remove('show'),2400);
}
document.querySelectorAll('.overlay').forEach(o=>{
    o.addEventListener('click',e=>{ if(e.target===o) o.classList.remove('active'); });
});
document.addEventListener('keydown',e=>{
    if(e.key==='Escape') document.querySelectorAll('.overlay.active').forEach(o=>o.classList.remove('active'));
});

// ── Init ──────────────────────────────────────────────
renderFilters();
renderSidebar();
renderMain();
</script>
