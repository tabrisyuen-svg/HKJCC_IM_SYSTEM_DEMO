// ── Attendance ─────────────────────────────────────────
function renderAttendance() {
  const s = currentStudent;
  const att = s.attendance;
  const attRate = Math.round(att.present / att.total * 100);
  const r = 54, cx = 70, cy = 70;
  const circ = 2 * Math.PI * r;
  const presentPct = att.present / att.total;
  const latePct    = att.late / att.total;
  const sickPct    = att.sick / att.total;
  const absentPct  = att.absent / att.total;

  function arc(pct, offset, color) {
    return `<circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${color}" stroke-width="12"
      stroke-dasharray="${pct*circ} ${circ}"
      stroke-dashoffset="${-offset*circ}"
      stroke-linecap="butt" transform="rotate(-90 ${cx} ${cy})"/>`;
  }

  const warnHTML = attRate < 80 ? `<div class="alert-box"><div>⚠️</div><p>子女本月出席率為 ${attRate}%，低於學校要求（80%），請注意。</p></div>` : '';

  document.getElementById('page-attendance').innerHTML = heroHTML() + warnHTML + `
    <div class="card">
      <div class="sec-title">📊 本月出席概況</div>
      <div class="att-ring-wrap">
        <svg class="ring-svg" width="140" height="140" viewBox="0 0 140 140">
          <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="var(--border)" stroke-width="12"/>
          ${arc(presentPct, 0, '#22C55E')}
          ${arc(latePct, presentPct, '#F59E0B')}
          ${arc(sickPct, presentPct+latePct, '#3B82F6')}
          ${arc(absentPct, presentPct+latePct+sickPct, '#EF4444')}
          <text x="${cx}" y="${cy}" text-anchor="middle" dominant-baseline="middle" fill="var(--text)" font-size="20" font-weight="800">${attRate}%</text>
          <text x="${cx}" y="${cy+18}" text-anchor="middle" fill="var(--muted)" font-size="10">出席率</text>
        </svg>
        <div class="att-legend">
          ${[['#22C55E','出席',att.present],['#F59E0B','遲到',att.late],['#3B82F6','病假',att.sick],['#EF4444','缺席',att.absent]].map(([c,l,v])=>`
          <div class="att-leg-row">
            <div class="att-leg-dot" style="background:${c}"></div>
            <div class="att-leg-label">${l}</div>
            <div class="att-leg-val" style="color:${c}">${v} 天</div>
          </div>`).join('')}
        </div>
      </div>
    </div>

    <div class="card">
      <div class="sec-title">📋 請假記錄</div>
      <table class="t-table">
        <thead><tr><th>日期</th><th>原因</th><th>天數</th><th>狀態</th></tr></thead>
        <tbody>
          ${s.leaveHistory.map(l=>`
          <tr>
            <td>${l.date}</td>
            <td>${l.reason}</td>
            <td>${l.days} 天</td>
            <td><span class="pill ${l.status==='approved'?'p-green':l.status==='rejected'?'p-red':'p-yellow'}">${l.status==='approved'?'已批准':l.status==='rejected'?'未批准':'審批中'}</span></td>
          </tr>`).join('')}
        </tbody>
      </table>
      <div style="margin-top:14px;">
        <button class="btn btn-green" onclick="goPage('leave')">＋ 新增請假申請</button>
      </div>
    </div>`;
}

