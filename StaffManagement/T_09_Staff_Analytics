const MODULE_COLORS = {
    attendance:'#3b82f6', homework:'#10b981', health:'#ef4444', events:'#f59e0b', timetable:'#8b5cf6'
};

let currentStaffId = 't1';
let currentPeriod = 'month';
const periods = ['week','month','term'];

// ── Period ────────────────────────────────────────────
function setPeriod(p) {
    currentPeriod = p;
    periods.forEach(x => {
        const btn = document.querySelector(`.period-btn[onclick="setPeriod('${x}')"]`);
        if (btn) btn.classList.toggle('active', x===p);
    });
    renderMain();
}

// ── Sidebar ───────────────────────────────────────────
function renderSidebar() {
    const list = document.getElementById('staffList');
    list.innerHTML = STAFF.map(s => {
        const scoreColor = s.score>=85?'#22c55e':s.score>=70?'#f97316':'#ef4444';
        return `
        <div class="staff-item${s.id===currentStaffId?' active':''}" onclick="selectStaff('${s.id}')">
            <div class="s-avatar" style="background:${s.avatar.bg};color:${s.avatar.color}">${s.avatar.init}</div>
            <div class="s-info">
                <div class="s-name">${s.name}</div>
                <div class="s-role">${s.role}</div>
            </div>
            <div style="display:flex;align-items:center;gap:6px;">
                ${s.alert?'<div class="alert-dot"></div>':''}
                <div class="s-score" style="color:${scoreColor}">${s.score}</div>
            </div>
        </div>`;
    }).join('');
}

function selectStaff(id) {
    currentStaffId = id;
    renderSidebar();
    renderMain();
}

// ── Main ──────────────────────────────────────────────
function renderMain() {
    const area = document.getElementById('mainArea');
    const t = STAFF.find(x=>x.id===currentStaffId);
    const scoreColor = t.score>=85?'#22c55e':t.score>=70?'#f97316':'#ef4444';
    const allScores = STAFF.map(s=>s.score);
    const avg = Math.round(allScores.reduce((a,b)=>a+b,0)/allScores.length);

    // period multiplier for display
    const mult = currentPeriod==='week'?0.25:currentPeriod==='term'?4:1;
    const pLabel = currentPeriod==='week'?'本週':currentPeriod==='term'?'本學期':'本月';

    const alerts = t.alerts.length ? `
        <div class="alert-banner">
            <div class="alert-banner-icon">⚠️</div>
            <div class="alert-banner-text">
                <strong>低活躍度警示</strong>
                ${t.alerts.map(a=>`<div>• ${a}</div>`).join('')}
            </div>
        </div>` : '';

    const trendData = currentPeriod==='week' ? t.trend.week : t.trend.month;
    const maxT = Math.max(...trendData);
    const trendBars = trendData.map((v,i)=>`
        <div class="trend-bar" style="height:${Math.round(v/maxT*32)}px;background:${scoreColor};opacity:${0.4+0.6*(i/(trendData.length-1))}"></div>`).join('');

    area.innerHTML = `
        <div class="detail-top">
            <div class="detail-avatar" style="background:${t.avatar.bg};color:${t.avatar.color}">${t.avatar.init}</div>
            <div style="flex:1">
                <div class="detail-name">${t.name}</div>
                <div class="detail-meta">${t.role} · 最後登入：${t.lastLogin}</div>
                <div class="trend-row">${trendBars}</div>
            </div>
            <div class="score-ring" style="flex-direction:column;align-items:flex-end;">
                <div class="score-big" style="color:${scoreColor}">${t.score}</div>
                <div class="score-sub">活躍度評分</div>
                <div style="font-size:11px;color:#bbb;margin-top:2px">全體平均 ${avg}</div>
            </div>
        </div>

        ${alerts}

        <div class="overview-grid">
            <div class="ov-card">
                <div class="ov-val" style="color:#3b82f6">${t.modules.attendance.rate}%</div>
                <div class="ov-lbl">點名完成率</div>
                <div class="ov-sub" style="color:#aaa">${pLabel} ${Math.round(t.modules.attendance.count*mult)} 次</div>
            </div>
            <div class="ov-card">
                <div class="ov-val" style="color:#10b981">${t.modules.homework.rate}%</div>
                <div class="ov-lbl">功課批改率</div>
                <div class="ov-sub" style="color:#aaa">${pLabel} ${Math.round(t.modules.homework.count*mult)} 次</div>
            </div>
            <div class="ov-card">
                <div class="ov-val" style="color:#ef4444">${t.modules.health.rate}%</div>
                <div class="ov-lbl">健康記錄</div>
                <div class="ov-sub" style="color:#aaa">${pLabel} ${Math.round(t.modules.health.count*mult)} 筆</div>
            </div>
            <div class="ov-card">
                <div class="ov-val" style="color:#f59e0b">${t.modules.events.rate}%</div>
                <div class="ov-lbl">活動管理</div>
                <div class="ov-sub" style="color:#aaa">${pLabel} ${Math.round(t.modules.events.count*mult)} 次</div>
            </div>
        </div>

        <div class="card">
            <div class="section-title"><span>📊</span> 各模組使用率</div>
            <div class="bar-chart">
                ${Object.entries(t.modules).map(([k,v])=>{
                    const color = MODULE_COLORS[k];
                    const pill = v.rate>=85?`pill-green`:v.rate>=70?`pill-orange`:`pill-red`;
                    return `<div class="bar-row">
                        <div class="bar-label">${v.label}</div>
                        <div class="bar-wrap"><div class="bar-fill" style="width:${v.rate}%;background:${color}"></div></div>
                        <div class="bar-val" style="color:${color}">${v.rate}%</div>
                    </div>`;
                }).join('')}
            </div>
        </div>

        <div class="card">
            <div class="section-title"><span>📋</span> 全體教師對比（${pLabel}）</div>
            <div style="overflow-x:auto;">
            <table class="mod-table">
                <thead><tr>
                    <th>教師</th><th>點名</th><th>功課</th><th>健康</th><th>活動</th><th>評分</th>
                </tr></thead>
                <tbody>
                    ${STAFF.map(s=>{
                        const sc = s.score>=85?'pill-green':s.score>=70?'pill-orange':'pill-red';
                        const getP = r => r>=85?'pill-green':r>=70?'pill-orange':'pill-red';
                        return `<tr style="${s.id===currentStaffId?'background:#f0f6ff;font-weight:600':''}">
                            <td>
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:28px;height:28px;border-radius:50%;background:${s.avatar.bg};color:${s.avatar.color};display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700">${s.avatar.init}</div>
                                    ${s.name}
                                </div>
                            </td>
                            <td><span class="pill ${getP(s.modules.attendance.rate)}">${s.modules.attendance.rate}%</span></td>
                            <td><span class="pill ${getP(s.modules.homework.rate)}">${s.modules.homework.rate}%</span></td>
                            <td><span class="pill ${getP(s.modules.health.rate)}">${s.modules.health.rate}%</span></td>
                            <td><span class="pill ${getP(s.modules.events.rate)}">${s.modules.events.rate}%</span></td>
                            <td><span class="pill ${sc}">${s.score}</span></td>
                        </tr>`;
                    }).join('')}
                </tbody>
            </table>
            </div>
        </div>

        <div class="card">
            <div class="section-title"><span>🕐</span> 最近操作記錄</div>
            ${t.logs.map(l=>`
            <div class="log-item">
                <div class="log-dot" style="background:${l.color}"></div>
                <div class="log-time">${l.time}</div>
                <div class="log-text">
                    ${l.text}
                    <span class="log-mod" style="background:${l.color}20;color:${l.color}">${l.modLabel}</span>
                </div>
            </div>`).join('')}
        </div>`;
}

// ── Export ────────────────────────────────────────────
function exportCSV() {
    let csv = '教師,班別,點名完成率,功課批改率,健康記錄率,活動管理率,時間表更新率,活躍度評分,最後登入\n';
    STAFF.forEach(s=>{
        csv += `${s.name},${s.cls},${s.modules.attendance.rate}%,${s.modules.homework.rate}%,${s.modules.health.rate}%,${s.modules.events.rate}%,${s.modules.timetable.rate}%,${s.score},${s.lastLogin}\n`;
    });
    const blob = new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8;'});
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `StaffAnalytics_${currentPeriod}.csv`;
    a.click();
}

// ── Init ──────────────────────────────────────────────
renderSidebar();
renderMain();
</script>
