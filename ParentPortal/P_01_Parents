        <div class="ic"><label>年齡</label><p>${s.age}</p></div>
      </div>
    </div>
    <div style="background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;">
      <div class="sec-title">🔒 資料保護聲明</div>
      <p style="font-size:13px;color:var(--muted);line-height:1.7">
        本家長端僅顯示與閣下子女相關之資料。所有個人資料均受系統權限保護，家長帳號只可查閱已綁定之學生檔案，其他學生資料均不可存取。如需更新聯絡資料，請直接聯絡學校辦公室。
      </p>
    </div>`;
}

// ── Toast ─────────────────────────────────────────────
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2400);
}
</script>
</body>
</html>
