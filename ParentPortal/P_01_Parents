let currentParent = null;
let currentStudent = null;
let currentPage = 'overview';

// ── Login ─────────────────────────────────────────────
function doLogin() {
  const idx = parseInt(document.getElementById('parentSelect').value);
  currentParent = PARENTS[idx];
  currentStudent = STUDENTS[currentParent.studentIdx];
  document.getElementById('loginWrap').style.display = 'none';
  document.getElementById('app').classList.add('show');
  document.getElementById('parentAv').textContent = currentParent.init;
  document.getElementById('parentAv').style.background = currentStudent.avColor;
  document.getElementById('parentAv').style.color = currentStudent.avText;
  document.getElementById('parentName').textContent = currentParent.name;
  const unread = currentStudent.notices.filter(n=>n.unread).length;
  document.getElementById('noticeBadge').textContent = unread;
  document.getElementById('noticeBadge').style.display = unread ? 'inline' : 'none';
  goPage('overview');
  showToast('歡迎，' + currentParent.name);
}

function doLogout() {
  document.getElementById('loginWrap').style.display = 'flex';
  document.getElementById('app').classList.remove('show');
  currentParent = null; currentStudent = null;
}

// ── Navigation ────────────────────────────────────────
function goPage(page) {
  currentPage = page;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-' + page).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const pages = ['overview','attendance','homework','events','health','leave','notices','profile'];
  const navItems = document.querySelectorAll('.nav-item');
  const idx = pages.indexOf(page);
  if (navItems[idx]) navItems[idx].classList.add('active');
  const renders = {
    overview: renderOverview, attendance: renderAttendance,
    homework: renderHomework, events: renderEvents,
    health: renderHealth, leave: renderLeave,
    notices: renderNotices, profile: renderProfile,
  };
  if (renders[page]) renders[page]();
}

