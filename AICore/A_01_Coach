    {id:'background',lb:'個人背景',tp:'textarea',ph:'工作經歷、學歷、主要技能或成就...',req:1},
    {id:'highlights',lb:'想突出的重點',tp:'text',ph:'例：管理經驗、跨國項目、特定技術專長',req:1},
    {id:'duration',lb:'長度',tp:'select',opts:['30秒電梯簡介','1分鐘版本','書面版本（200字）'],req:1},
    {id:'tone',lb:'語氣',tp:'select',opts:['正式專業','親切自然','自信有活力'],req:1},
   ],
   gen(f){return`你是一位職涯發展顧問及個人品牌專家，擅長協助不同背景的人撰寫有吸引力、令人印象深刻的自我介紹。\n\n請為以下場合撰寫自我介紹：【${f.purpose}】\n\n━━━ 個人資料 ━━━\n個人背景：${f.background}\n想突出的重點：${f.highlights}\n長度：${f.duration}\n語氣：${f.tone}\n\n━━━ 格式及限制 ━━━\n• 針對【${f.purpose}】的場合調整內容重點和語氣\n• 長度：【${f.duration}】\n• 開場需有記憶點，不要以「大家好，我叫XX」這種平淡方式開始\n• 重點突出：${f.highlights}\n• 語氣【${f.tone}】，自然流暢，適合口語表達\n• 結尾需留下深刻印象或引發對話的話題\n• 嚴格根據提供的背景資料，不可捏造未提及的經歷\n• 個人化細節不確定處以 [請填寫] 標示`}
  },
];

const ERR_POOL=[
  '偵測到輸入內容複雜度超出當前處理閾值，語意分析模組無法完成解析',
  '自然語言推理引擎發生內部衝突，請求已被安全中止以防止輸出錯誤',
  '系統負載異常，分配至本請求的運算資源不足，請稍後重試',
  '內容安全過濾器觸發誤判，請求被標記為待人工審核狀態',
  '語言模型上下文視窗溢出，輸入標記數量超出當前限制',
  '分佈式節點同步失敗，無法確保輸出結果的一致性',
  '本地快取索引發生損壞，無法取得必要的語義向量數據',
  '請求優先級隊列異常，任務調度器發生意外中斷',
  '熱詞偵測系統誤觸發，請求被臨時凍結等待系統解封',
  '模型權重載入超時，推理引擎未能在規定時限內完成初始化',
];

let curCat='email', curTpl=null, twTimer=null, resText='';

(function init(){
  renderCats();
  renderTpls('email');
})();

function renderCats(){
  document.getElementById('cats').innerHTML=CATS.map(c=>`
    <button class="cat-btn${c.id===curCat?' on':''}" onclick="selCat('${c.id}')">${c.ic} ${c.nm}</button>
  `).join('');
}

function selCat(id){curCat=id;renderCats();renderTpls(id);}

function renderTpls(cat){
  document.getElementById('tplList').innerHTML=T.filter(t=>t.cat===cat).map(t=>`
    <div class="tc${curTpl&&curTpl.id===t.id?' on':''}" onclick="selTpl('${t.id}')">
      <span class="tc-ic">${t.ic}</span>
      <div class="tc-info">
        <div class="tc-nm">${t.nm}</div>
        <div class="tc-ds">${t.ds}</div>
        <span class="tg tg-${t.tg}">${t.tg}</span>
      </div>
    </div>
  `).join('');
}

function selTpl(id){
  if(twTimer){clearInterval(twTimer);twTimer=null;}
  curTpl=T.find(t=>t.id===id);
  if(!curTpl)return;
  renderTpls(curCat);
  document.getElementById('welcome').classList.add('hidden');
  document.getElementById('mainArea').classList.remove('hidden');
  document.getElementById('obox').classList.add('hidden');
  showSt(null);
  document.getElementById('fhdIc').textContent=curTpl.ic;
  document.getElementById('fhdNm').textContent=curTpl.nm;
  document.getElementById('fhdDs').textContent=curTpl.ds;
  const tg=document.getElementById('fhdTg');
  tg.textContent=curTpl.tg;tg.className=`tg tg-${curTpl.tg}`;
  renderFlds(curTpl.flds);
  if(window.innerWidth<=680)document.getElementById('mainArea').scrollIntoView({behavior:'smooth',block:'start'});
}

function renderFlds(flds){
  document.getElementById('fbody').innerHTML=flds.map(f=>{
    let inp='';
    if(f.tp==='text') inp=`<input class="fi" type="text" id="f_${f.id}" placeholder="${f.ph||''}" ${f.req?'required':''}>`;
    else if(f.tp==='textarea') inp=`<textarea class="fta" id="f_${f.id}" placeholder="${f.ph||''}" rows="3" ${f.req?'required':''}></textarea>`;
    else if(f.tp==='select') inp=`<select class="fs" id="f_${f.id}">${f.opts.map(o=>`<option>${o}</option>`).join('')}</select>`;
    return`<div class="fg"><label class="fl" for="f_${f.id}">${f.lb}${f.req?'<span class="fl-r">*</span>':'<span class="fl-o">（選填）</span>'}</label>${inp}</div>`;
  }).join('');
}

function resetForm(){
  if(!curTpl)return;
  curTpl.flds.forEach(f=>{
    const el=document.getElementById('f_'+f.id);
    if(!el)return;
    if(f.tp==='select')el.selectedIndex=0;
    else el.value='';
    el.style.borderColor='';el.style.background='';
  });
  document.getElementById('obox').classList.add('hidden');
  showSt(null);
}

function collectVals(){
  const vals={};let ok=true;
  curTpl.flds.forEach(f=>{
    const el=document.getElementById('f_'+f.id);
    if(!el)return;
    const v=el.value.trim();
    if(f.req&&!v){el.style.borderColor='#EF4444';el.style.background='#FFF5F5';ok=false;}
    else{el.style.borderColor='';el.style.background='';}
    vals[f.id]=v;
  });
  return ok?vals:null;
}

function generate(){
  if(!curTpl)return;
  if(twTimer){clearInterval(twTimer);twTimer=null;}
  ['sp1','sp2','sp3','sp4'].forEach(s=>{const e=document.getElementById(s);if(e)e.classList.remove('show');});

  const vals=collectVals();
  if(!vals)return;

  document.getElementById('obox').classList.remove('hidden');
  showSt('Thinking');
  document.getElementById('genBtn').disabled=true;

  const n1=Math.floor(Math.random()*100)+1;
  const n2=Math.floor(Math.random()*100)+1;
  const isErr=(n1===n2);

  ['sp1','sp2','sp3','sp4'].forEach((s,i)=>{
    setTimeout(()=>{const e=document.getElementById(s);if(e)e.classList.add('show');},300+i*480);
  });

  const delay=3000+Math.random()*2000;
  setTimeout(()=>{
    document.getElementById('genBtn').disabled=false;
    ['sp1','sp2','sp3','sp4'].forEach(s=>{const e=document.getElementById(s);if(e)e.classList.remove('show');});
    if(isErr){showErrState(n1,n2);}
    else{showResult(curTpl.gen(vals));}
  },delay);
}

function showSt(st){
  ['stThinking','stError','stResult'].forEach(id=>{
    const e=document.getElementById(id);if(e)e.classList.add('hidden');
  });
  if(st){const e=document.getElementById('st'+st);if(e)e.classList.remove('hidden');}
}

function showErrState(n1,n2){
  showSt('Error');
  document.getElementById('errCode').textContent=`ERR_${String(n1).padStart(4,'0')} / MATCH_CONFLICT`;
  const cnt=3+Math.floor(Math.random()*3);
  const picked=[...ERR_POOL].sort(()=>Math.random()-.5).slice(0,cnt);
  document.getElementById('errReasons').innerHTML=picked.map((r,i)=>`
    <div class="err-r"><span class="err-rn">[E${String(i+1).padStart(2,'0')}]</span><span>${r}</span></div>
  `).join('');
  document.getElementById('obox').scrollIntoView({behavior:'smooth',block:'nearest'});
}

function dismissErr(){
  document.getElementById('obox').classList.add('hidden');
  showSt(null);
}

function showResult(text){
  resText=text;
  showSt('Result');
  const body=document.getElementById('resBody');
  const cb=document.getElementById('copyBtn');
  cb.classList.add('inv');
  body.textContent='';
  document.getElementById('obox').scrollIntoView({behavior:'smooth',block:'nearest'});

  let i=0;
  const cur=document.createElement('span');
  cur.className='cur';
  body.appendChild(cur);

  if(twTimer)clearInterval(twTimer);
  twTimer=setInterval(()=>{
    if(i<text.length){
      cur.insertAdjacentText('beforebegin',text[i]);
      i++;
      body.scrollTop=body.scrollHeight;
    } else {
      clearInterval(twTimer);twTimer=null;
      cur.remove();
      cb.classList.remove('inv');
      document.getElementById('resWc').textContent=`共 ${text.length} 個字符`;
    }
  },15);
}

function doCopy(){
  if(!resText)return;
  const cb=document.getElementById('copyBtn');
  const copy=()=>{cb.classList.add('ok');cb.innerHTML='<span>✓</span><span>已複製！</span>';setTimeout(()=>{cb.classList.remove('ok');cb.innerHTML='<span>📋</span><span>複製</span>';},2000);};
  if(navigator.clipboard){navigator.clipboard.writeText(resText).then(copy).catch(()=>{fb();copy();});}
  else{fb();copy();}
  function fb(){const ta=document.createElement('textarea');ta.value=resText;ta.style.position='fixed';ta.style.opacity='0';document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);}
}
</script>
</body>
</html>
