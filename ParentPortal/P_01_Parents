<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>家長端 · P-01</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --green:#1B6E3C;--green-light:#24A05A;--yellow:#F5C518;
  --dark:#0D1B2A;--card:#162032;--card2:#1E2D42;
  --border:#2A3D55;--text:#E8EDF3;--muted:#7A90A8;
  --red:#EF4444;--blue:#3B82F6;--purple:#8B5CF6;--orange:#F97316;
}
body{font-family:'Segoe UI','Microsoft JhengHei',sans-serif;background:var(--dark);color:var(--text);min-height:100vh;}

/* Login */
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;}
.login-box{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:40px 36px;width:100%;max-width:380px;}
.login-logo{text-align:center;margin-bottom:28px;}
.login-logo .ico{font-size:40px;margin-bottom:10px;}
.login-logo h1{font-size:20px;font-weight:700;}
.login-logo h1 span{color:var(--yellow);}
.login-logo p{font-size:12px;color:var(--muted);margin-top:4px;}
.form-label{font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.06em;text-transform:uppercase;display:block;margin-bottom:6px;}
.form-input,.form-select{width:100%;background:var(--card2);border:1px solid var(--border);border-radius:10px;padding:11px 14px;color:var(--text);font-size:14px;outline:none;margin-bottom:14px;transition:border-color .2s;font-family:inherit;}
.form-input:focus,.form-select:focus{border-color:var(--green-light);}
.form-input::placeholder{color:var(--muted);}
.login-hint{font-size:11px;color:var(--muted);margin-bottom:20px;background:var(--card2);border-radius:8px;padding:10px 12px;line-height:1.6;}
.login-hint strong{color:var(--yellow);}
.btn-login{width:100%;background:var(--green);color:#fff;border:none;border-radius:10px;padding:13px;font-size:15px;font-weight:700;cursor:pointer;transition:.2s;}
.btn-login:hover{background:var(--green-light);}

/* App */
.app{display:none;flex-direction:column;min-height:100vh;}
.app.show{display:flex;}

/* Header */
.header{background:#0a1520;border-bottom:1px solid var(--border);padding:14px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;position:sticky;top:0;z-index:50;}
.header-left{display:flex;align-items:center;gap:14px;}
.logo{font-size:12px;font-weight:700;letter-spacing:.08em;color:var(--yellow);}
.header-title{font-size:15px;font-weight:600;}
.parent-info{display:flex;align-items:center;gap:10px;}
.parent-av{width:34px;height:34px;border-radius:50%;background:rgba(27,110,60,.3);color:#4ADE80;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;}
.parent-name{font-size:13px;font-weight:600;}
.parent-role{font-size:10px;color:var(--muted);}
.btn-logout{background:var(--card2);border:1px solid var(--border);color:var(--muted);border-radius:8px;padding:6px 12px;font-size:12px;cursor:pointer;transition:.2s;}
.btn-logout:hover{color:var(--red);border-color:var(--red);}

/* Body layout */
.body-wrap{display:flex;flex:1;}

/* Sidebar nav */
.sidenav{width:220px;background:var(--card);border-right:1px solid var(--border);padding:16px 0;flex-shrink:0;}
.nav-label{font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--muted);padding:8px 18px 6px;text-transform:uppercase;}
.nav-item{display:flex;align-items:center;gap:12px;padding:11px 18px;cursor:pointer;transition:.15s;border-left:3px solid transparent;font-size:13px;color:var(--muted);}
.nav-item:hover{background:var(--card2);color:var(--text);}
.nav-item.active{background:rgba(27,110,60,.15);border-left-color:var(--green-light);color:var(--text);}
.nav-item .n-ico{font-size:16px;width:22px;text-align:center;}
.nav-badge{margin-left:auto;background:var(--red);color:#fff;border-radius:10px;padding:1px 7px;font-size:10px;font-weight:700;}

/* Main content */
.main{flex:1;padding:24px;overflow-y:auto;}
.page{display:none;}
.page.active{display:block;}

/* Student card at top */
.stu-hero{background:linear-gradient(135deg,var(--green),#0F4A28);border-radius:16px;padding:22px;display:flex;align-items:center;gap:18px;margin-bottom:22px;position:relative;overflow:hidden;}
.stu-hero::before{content:'';position:absolute;right:-30px;top:-30px;width:150px;height:150px;border-radius:50%;background:rgba(245,197,24,.08);}
.stu-av{width:62px;height:62px;border-radius:50%;border:3px solid var(--yellow);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;background:rgba(0,0,0,.3);flex-shrink:0;}
.stu-info h2{font-size:20px;font-weight:700;}
.stu-info h3{font-size:13px;color:rgba(255,255,255,.6);margin-top:2px;}
.stu-badges{display:flex;gap:7px;margin-top:9px;flex-wrap:wrap;}
.bdg{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;}
.bc{background:var(--yellow);color:#000;}
.bi{background:rgba(255,255,255,.15);color:#fff;}
.bo{background:rgba(34,197,94,.2);color:#86EFAC;border:1px solid rgba(34,197,94,.3);}
.bs{background:rgba(239,68,68,.2);color:#FCA5A5;border:1px solid rgba(239,68,68,.4);}

/* Stat cards */
.stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-bottom:22px;}
.stat-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:16px;}
.stat-val{font-size:26px;font-weight:700;margin-bottom:4px;}
.stat-lbl{font-size:11px;color:var(--muted);font-weight:600;letter-spacing:.04em;text-transform:uppercase;}
.stat-sub{font-size:11px;margin-top:5px;font-weight:500;}

/* Section */
.sec-title{font-size:13px;font-weight:600;color:var(--yellow);margin-bottom:12px;display:flex;align-items:center;gap:6px;}
.card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;margin-bottom:16px;}

/* Table */
.t-table{width:100%;border-collapse:collapse;}
.t-table th{font-size:10px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;padding:8px 10px;text-align:left;border-bottom:2px solid var(--border);}
.t-table td{padding:11px 10px;font-size:13px;border-bottom:1px solid rgba(42,61,85,.5);vertical-align:middle;}
.t-table tr:last-child td{border-bottom:none;}
.t-table tr:hover td{background:rgba(30,45,66,.5);}
.pill{display:inline-block;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.p-green{background:rgba(34,197,94,.15);color:#86EFAC;}
.p-red{background:rgba(239,68,68,.15);color:#FCA5A5;}
.p-yellow{background:rgba(245,197,24,.15);color:#FDE68A;}
.p-blue{background:rgba(59,130,246,.15);color:#93C5FD;}
.p-gray{background:rgba(148,163,184,.1);color:var(--muted);}
.p-orange{background:rgba(249,115,22,.15);color:#FDBA74;}

/* Timeline */
.tl{position:relative;padding-left:22px;}
.tl::before{content:'';position:absolute;left:7px;top:0;bottom:0;width:2px;background:var(--border);}
.tli{position:relative;margin-bottom:16px;}
.tldot{position:absolute;left:-18px;top:4px;width:12px;height:12px;border-radius:50%;border:2px solid var(--dark);}
.tldate{font-size:11px;color:var(--muted);margin-bottom:3px;}
.tlcard{background:var(--card2);border-radius:8px;padding:11px;border:1px solid var(--border);}
.tlcard h4{font-size:13px;font-weight:600;margin-bottom:3px;}
.tlcard p{font-size:12px;color:var(--muted);}

/* Attendance ring */
.att-ring-wrap{display:flex;align-items:center;gap:24px;flex-wrap:wrap;}
.ring-svg{flex-shrink:0;}
.att-legend{flex:1;min-width:150px;}
.att-leg-row{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.att-leg-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;}
.att-leg-label{font-size:13px;flex:1;}
.att-leg-val{font-size:13px;font-weight:700;}

/* Notice item */
.notice-item{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid rgba(42,61,85,.5);align-items:flex-start;}
.notice-item:last-child{border-bottom:none;}
.notice-dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:5px;}
.notice-time{font-size:11px;color:var(--muted);white-space:nowrap;min-width:80px;}
.notice-content h4{font-size:13px;font-weight:600;margin-bottom:3px;}
.notice-content p{font-size:12px;color:var(--muted);line-height:1.55;}
.notice-unread{background:var(--red);color:#fff;font-size:9px;font-weight:700;padding:1px 6px;border-radius:6px;margin-left:6px;vertical-align:middle;}

/* Leave form */
.leave-form{background:var(--card2);border-radius:12px;padding:20px;border:1px solid var(--border);}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.btn{padding:9px 18px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:none;transition:.2s;white-space:nowrap;}
.btn:hover{opacity:.85;}
.btn-green{background:var(--green);color:#fff;}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--muted);}

/* Health tags */
.tag{display:inline-block;padding:4px 10px;border-radius:20px;font-size:11px;margin:2px;}
.tr{background:rgba(239,68,68,.15);color:#FCA5A5;border:1px solid rgba(239,68,68,.3);}
.tb{background:rgba(59,130,246,.15);color:#93C5FD;border:1px solid rgba(59,130,246,.3);}
.tg{background:rgba(34,197,94,.15);color:#86EFAC;border:1px solid rgba(34,197,94,.3);}
.tgr{background:rgba(148,163,184,.1);color:var(--muted);border:1px solid var(--border);}

/* Info grid */
.igrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;}
.ic{background:var(--card2);border-radius:10px;padding:12px;border:1px solid var(--border);}
.ic label{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;display:block;margin-bottom:5px;}
.ic p{font-size:14px;font-weight:500;}

/* Toast */
.toast{position:fixed;bottom:24px;right:24px;background:var(--green);color:#fff;padding:12px 18px;border-radius:10px;font-size:13px;font-weight:600;transform:translateY(60px);opacity:0;transition:all .3s;z-index:200;pointer-events:none;}
.toast.show{transform:translateY(0);opacity:1;}

/* Alert box */
.alert-box{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:10px;padding:13px 16px;display:flex;gap:10px;align-items:flex-start;margin-bottom:16px;}
.alert-box p{font-size:13px;color:#FCA5A5;line-height:1.55;}

@media(max-width:700px){
  .sidenav{display:none;}
  .stat-grid{grid-template-columns:1fr 1fr;}
  .form-row{grid-template-columns:1fr;}
  .main{padding:14px;}
}
</style>
</head>
